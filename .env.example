# ================================
# SkyCompare Design System
# Environment Variables Template
# ================================

# GitHub Configuration
# ---------------------
# Personal Access Token para integração com GitHub
# Como gerar: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# URL do repositório GitHub
GITHUB_REPO_URL=https://github.com/username/design-system-angular

# Owner do repositório (username ou organização)
GITHUB_OWNER=username

# Nome do repositório
GITHUB_REPO=design-system-angular

# API Configuration
# -----------------
# URL base da API (staging ou produção)
API_URL=https://api.skycompare.com/api

# Feature Flags
# -------------
# Habilitar/desabilitar features específicas
ENABLE_ANALYTICS=true
ENABLE_COMPARISON=true
ENABLE_SEARCH=true

# App Configuration
# -----------------
# Nome da aplicação
APP_NAME=SkyCompare Design System

# Versão da aplicação
APP_VERSION=1.0.0

# Debug Configuration (apenas dev/staging)
# ----------------------------------------
ENABLE_LOGS=true
SHOW_PERFORMANCE_METRICS=true

# Instruções de Uso
# -----------------
# 1. Copie este arquivo como .env.local
# 2. Preencha os valores reais
# 3. Nunca commite o arquivo .env.local (já está no .gitignore)
# 4. Para produção, configure as variáveis no seu serviço de hosting
